# ── Supabase (Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) hoặc anon key cũ
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) hoặc service_role key cũ. TUYỆT ĐỐI không chia sẻ.
SUPABASE_SECRET_KEY=
# Chỉ cần khi chạy `npm run db:migrate` (Project Settings → Database → Connection string → URI)
SUPABASE_DB_URL=

# ── OpenAI ──
OPENAI_API_KEY=
# Model trò chuyện (rẻ và đủ tốt cho tiếng Việt)
OPENAI_MODEL=gpt-5.4-mini
# Model kiểm tra an toàn
OPENAI_SAFETY_MODEL=gpt-5.4-mini

# ── Thầy cô tự tạo tài khoản ──
# Mã chung để thầy cô tự đăng ký ở /staff/login (để trống = tắt, chỉ admin tạo được)
STAFF_SIGNUP_CODE=

# ── Thông tin hỗ trợ của trường (hiện trên thẻ khẩn cấp) ──
SCHOOL_COUNSELING_NAME=Phòng tham vấn tâm lý
SCHOOL_COUNSELING_DETAIL=Tầng ?, phòng ? · Giờ làm việc: ?
SCHOOL_COUNSELING_PHONE=
